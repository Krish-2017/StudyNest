# Server
PORT=3000

# AI: use demo mode by leaving AI_PROVIDER empty.
# Set one provider and its matching key only in your host's environment settings.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Alternative provider
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
